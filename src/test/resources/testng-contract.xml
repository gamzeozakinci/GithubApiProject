<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="contract" verbose="1">
    <listeners>
        <listener class-name="com.apitests.github.utils.ExtentTestListener"/>
    </listeners>
    <test name="GitHub API Tests - contract">
        <groups>
            <run>
                <include name="contract"/>
            </run>
